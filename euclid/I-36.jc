// I.36: Parallelograms on equal bases
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-5, 0);
B = point(-1, 0);
D = point(-4, 3);
C=point(map () -> X(B)+X(D)-X(A),map () -> Y(B)+Y(D)-Y(A)) <<name:'C', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
l=line(A,B) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
m=line(D,C) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
slide=slider([-6,-3],[-2,-3],[-1,1.75,3]) <<name:'Shear',snapWidth:0.01>>;
E=point(map () -> X(D)+(slide.Value())*(X(C)-X(D)),map () -> Y(D)+(slide.Value())*(Y(C)-Y(D))) <<name:'E', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
U=point(map () -> X(A)+(1.6)*(X(B)-X(A)),map () -> Y(A)+(1.6)*(Y(B)-Y(A))) <<name:'U', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
V=point(map () -> X(B)+X(U)-X(A),map () -> Y(B)+Y(U)-Y(A)) <<name:'V', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
F=point(map () -> X(V)+X(E)-X(U),map () -> Y(V)+Y(E)-Y(U)) <<name:'F', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
polygon(A,B,C,D) <<fillColor:'#cf9945', fillOpacity:0.15, borders:<<strokeColor:'#846632',strokeWidth:2>>>>;
polygon(U,V,F,E) <<fillColor:'#cf9945', fillOpacity:0.15, borders:<<strokeColor:'#846632',strokeWidth:2>>>>;
text(-8,8,'I.36') <<display:'internal',fontSize:20>>;

// Euclid, Elements, Book I — JessieCode / JSXGraph 1.12.2
// Original implementation, MIT license. Sources: github.com/jsxgraph/JessieCode and mathcs.clarku.edu/~djoyce/elements/bookI/bookI.html.
// Blue points are inputs. Derived points follow their parents.
// Coordinates implement the Euclidean plane; numerical checks are not proofs.
// Avoid coincident inputs, collinear triangles, and zero/straight given angles.
$board.setBoundingBox([-9, 9, 13, -9], true);
near = function(a,b) { return abs(a-b) < 0.000001*(1+abs(a)+abs(b));
};
len = function(a,b) { return sqrt((X(a)-X(b))^2+(Y(a)-Y(b))^2);
};
triangleArea = function(a,b,c) { return abs((X(b)-X(a))*(Y(c)-Y(a))-(Y(b)-Y(a))*(X(c)-X(a)))/2;
};
ang = function(a,b,c) { return acos(max(-1,min(1,((X(a)-X(b))*(X(c)-X(b))+(Y(a)-Y(b))*(Y(c)-Y(b)))/(len(a,b)*len(c,b)))));
};
pt = function(x,y,n) { return point(x,y) <<name:n, size:3, strokeColor:'#245ea6', fillColor:'#245ea6'>>;
};
dp = function(f,g,n) { return point(f,g) <<name:n, size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
};
seg = function(a,b) { return segment(a,b) <<strokeWidth:2, strokeColor:'#34465d'>>;
};
tri = function(a,b,c) { return polygon(a,b,c) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
};
quad = function(a,b,c,d) { return polygon(a,b,c,d) <<fillColor:'#cf9945', fillOpacity:0.15, borders:<<strokeColor:'#846632',strokeWidth:2>>>>;
};
par = function(a,b,c,n) { return dp(function(){return X(b)+X(c)-X(a);},function(){return Y(b)+Y(c)-Y(a);},n);
};
along = function(a,b,t,n) { return dp(function(){return X(a)+t()*(X(b)-X(a));},function(){return Y(a)+t()*(Y(b)-Y(a));},n);
};
readout = function(y,label,f) { return text(-8,y,function(){return label+': '+round(f()*10000)/10000;}) <<display:'internal',fontSize:15>>;
};
mark = function(a,b,c,n) { return angle(a,b,c) <<name:n, radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
};
// I.44: Apply an equal-area parallelogram to a given segment
// Coordinate construction: scale ray UH until the determinant with UV equals the target area. The angle VUH is preserved. I.42 uses a bisected triangle base and parallels; I.44 transfers area to a prescribed base via I.43; I.45 triangulates the figure and combines the resulting parallelograms. The I.45 example is a convex quadrilateral with internal diagonal AC; the accompanying general helper accepts a triangulation. These examples implement the result, not every auxiliary line in Euclid's proof.
pA=pt(-6,0,'A');
pB=pt(-2,0,'B');
pC=pt(-5,3,'C');
tri(pA,pB,pC);
pU=pt(1,0,'U');
pV=pt(5,0,'V');
pH=pt(3,3,'H');
seg(pU,pH);
target=function(){return triangleArea(pA,pB,pC);};
cross=function(){return abs((X(pV)-X(pU))*(Y(pH)-Y(pU))-(Y(pV)-Y(pU))*(X(pH)-X(pU)));};
pW=along(pU,pH,function(){return target()/cross();},'W');
pZ=par(pU,pV,pW,'Z');
quad(pU,pV,pZ,pW);
seg(pU,pV);
mark(pV,pU,pW,'δ');
check = function(){return near(triangleArea(pU,pV,pZ)+triangleArea(pU,pZ,pW),target()) && near(ang(pV,pU,pW),ang(pV,pU,pH));};
readout(-5,'Given area',target);
readout(-6,'Constructed area',function(){return triangleArea(pU,pV,pZ)+triangleArea(pU,pZ,pW);});
text(-8,8,'I.44') <<display:'internal',fontSize:20>>;
text(-8,-8,function(){return check() ? '✓' : 'Degenerate or invalid inputs';}) <<display:'internal',fontSize:14>>;

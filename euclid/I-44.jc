// I.44: Apply an equal-area parallelogram to a given segment
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-6, 0);
B = point(-2, 0);
C = point(-5, 3);
polygon(A,B,C) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
U = point(1, 0);
V = point(5, 0);
H = point(3, 3);
segment(U,H) <<strokeWidth:2, strokeColor:'#34465d'>>;
target=map () -> abs((X(B)-X(A))*(Y(C)-Y(A))-(Y(B)-Y(A))*(X(C)-X(A)))/2;
cross=map () -> abs((X(V)-X(U))*(Y(H)-Y(U))-(Y(V)-Y(U))*(X(H)-X(U)));
W=point(map () -> X(U)+(target()/cross())*(X(H)-X(U)),map () -> Y(U)+(target()/cross())*(Y(H)-Y(U))) <<name:'W', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
Z=point(map () -> X(V)+X(W)-X(U),map () -> Y(V)+Y(W)-Y(U)) <<name:'Z', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
polygon(U,V,Z,W) <<fillColor:'#cf9945', fillOpacity:0.15, borders:<<strokeColor:'#846632',strokeWidth:2>>>>;
segment(U,V) <<strokeWidth:2, strokeColor:'#34465d'>>;
angle(V,U,W) <<name:'δ', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.44') <<display:'internal',fontSize:20>>;

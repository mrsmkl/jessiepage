// I.2: Transfer a segment to a given point
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-3, 0);
B = point(0, 0);
C = point(1, 2);
segment(B,C) <<strokeWidth:2, strokeColor:'#34465d'>>;
c1=circle(A,B) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
c2=circle(B,A) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
D=intersection(c1,c2,0) <<name:'D'>>;
G=point(map () -> X(D)+(1+dist(B,C)/dist(D,B))*(X(B)-X(D)),map () -> Y(D)+(1+dist(B,C)/dist(D,B))*(Y(B)-Y(D))) <<name:'G', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
circle(B,C) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
segment(D,G) <<strokeWidth:2, strokeColor:'#34465d'>>;
L=point(map () -> X(D)+(dist(D,G)/dist(D,A))*(X(A)-X(D)),map () -> Y(D)+(dist(D,G)/dist(D,A))*(Y(A)-Y(D))) <<name:'L', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
circle(D,G) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
segment(D,L) <<strokeWidth:2, strokeColor:'#34465d'>>;
segment(A,L) <<strokeWidth:2, strokeColor:'#34465d'>>;
polygon(D,A,B) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
text(-8,8,'I.2') <<display:'internal',fontSize:20>>;

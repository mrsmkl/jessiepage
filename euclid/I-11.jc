// I.11: Erect a perpendicular at a point on a line
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-3, 0);
B = point(3, 0);
l=line(A,B) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
P = point(0, 0);
P.glide(l);
D=point(map () -> X(P)+(-1)*(X(A)-X(P)),map () -> Y(P)+(-1)*(Y(A)-Y(P))) <<name:'D', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
c1=circle(A,D) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
c2=circle(D,A) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
E=intersection(c1,c2,0) <<name:'E'>>;
segment(A,D) <<strokeWidth:2, strokeColor:'#34465d'>>;
segment(P,E) <<strokeWidth:2, strokeColor:'#34465d'>>;
angle(A,P,E) <<name:'', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.11') <<display:'internal',fontSize:20>>;

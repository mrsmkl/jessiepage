// Euclid Book I — Common notion 4: Coincidence gives equality
// Magnitudes that coincide under superposition are equal.
// Illustrative model of an assumption, not a proof.
// Used in: I.4 superposition argument.
$board.setBoundingBox([-10, 7, 10, -7], true);

A = point(-6, -1);
B = point(-3, -1);
C = point(-5, 2);
t=slider([-6,-4],[3,-4],[0,0,1]) <<name:'Superposition'>>;
D=point(map () -> X(A)+7*(1-t.Value()),map () -> Y(A));
E=point(map () -> X(B)+7*(1-t.Value()),map () -> Y(B));
F=point(map () -> X(C)+7*(1-t.Value()),map () -> Y(C));
polygon(A,B,C) <<fillColor:'#548abd',fillOpacity:0.3>>;
polygon(D,E,F) <<fillColor:'#cf9945',fillOpacity:0.3>>;
text(-9,-5.5,function(){return abs(1-t.Value())<0.001 ? 'The triangles coincide, so corresponding parts are equal.' : 'Move Superposition to 1. Separation = '+round(100*7*(1-t.Value()))/100;}) <<display:'internal',fontSize:16>>;
text(-9,6,'Common notion 4: Coincidence gives equality') <<display:'internal',fontSize:18>>;

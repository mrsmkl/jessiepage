// I.32: Exterior angle and the triangle angle sum
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-3, 0);
B = point(3, 0);
C = point(-1, 4);
polygon(A,B,C) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
D=point(map () -> X(B)+(1.6)*(X(C)-X(B)),map () -> Y(B)+(1.6)*(Y(C)-Y(B))) <<name:'D', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
segment(C,D) <<strokeWidth:2, strokeColor:'#34465d'>>;
parallel(line(A,B),C) <<dash:2>>;
angle(C,A,B) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
angle(A,B,C) <<name:'β', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
angle(A,C,D) <<name:'α+β', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.32') <<display:'internal',fontSize:20>>;

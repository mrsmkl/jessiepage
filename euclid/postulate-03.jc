// Euclid Book I — Postulate 3: Draw a circle
// A circle can be drawn with any center and distance.
// Illustrative model of an assumption, not a proof.
// Used in: I.1–3, I.9–12, I.22.
$board.setBoundingBox([-10, 7, 10, -7], true);

O = point(0, 0);
A = point(3, 1);
c=circle(O,A) <<strokeWidth:3>>;
segment(O,A) <<dash:2>>;
text(-9,-5,'Center O; radius OA. Move either point.') <<display:'internal',fontSize:16>>;
text(-9,6,'Postulate 3: Draw a circle') <<display:'internal',fontSize:18>>;

// I.46: Construct a square on a segment
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-2, 2);
B = point(2, 2);
D=point(map () -> X(A)-(1)*(Y(B)-Y(A)),map () -> Y(A)+(1)*(X(B)-X(A))) <<name:'D', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
C=point(map () -> X(B)+X(D)-X(A),map () -> Y(B)+Y(D)-Y(A)) <<name:'C', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
polygon(A,B,C,D) <<fillColor:'#cf9945', fillOpacity:0.15, borders:<<strokeColor:'#846632',strokeWidth:2>>>>;
angle(A,B,C) <<name:'', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.46') <<display:'internal',fontSize:20>>;

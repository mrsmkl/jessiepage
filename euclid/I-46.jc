// Euclid, Elements, Book I — JessieCode / JSXGraph 1.12.2
// Original implementation, MIT license. Sources: github.com/jsxgraph/JessieCode and mathcs.clarku.edu/~djoyce/elements/bookI/bookI.html.
// Blue points are inputs. Derived points follow their parents.
// Coordinates implement the Euclidean plane; numerical checks are not proofs.
// Avoid coincident inputs, collinear triangles, and zero/straight given angles.
$board.setBoundingBox([-9, 9, 13, -9], true);
near = function(a,b) { return abs(a-b) < 0.000001*(1+abs(a)+abs(b));
};
len = function(a,b) { return sqrt((X(a)-X(b))^2+(Y(a)-Y(b))^2);
};
ang = function(a,b,c) { return acos(max(-1,min(1,((X(a)-X(b))*(X(c)-X(b))+(Y(a)-Y(b))*(Y(c)-Y(b)))/(len(a,b)*len(c,b)))));
};
pt = function(x,y,n) { return point(x,y) <<name:n, size:3, strokeColor:'#245ea6', fillColor:'#245ea6'>>;
};
dp = function(f,g,n) { return point(f,g) <<name:n, size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
};
quad = function(a,b,c,d) { return polygon(a,b,c,d) <<fillColor:'#cf9945', fillOpacity:0.15, borders:<<strokeColor:'#846632',strokeWidth:2>>>>;
};
par = function(a,b,c,n) { return dp(function(){return X(b)+X(c)-X(a);},function(){return Y(b)+Y(c)-Y(a);},n);
};
normal = function(a,b,t,n) { return dp(function(){return X(a)-t()*(Y(b)-Y(a));},function(){return Y(a)+t()*(X(b)-X(a));},n);
};
mark = function(a,b,c,n) { return angle(a,b,c) <<name:n, radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
};
// I.46: Construct a square on a segment
// Erect AD perpendicular to AB by I.11 and cut AD=AB by I.3. Draw the two parallels by I.31. I.34 and I.29 give four equal sides and right angles. Rotation and vector-sum helpers encode these operations.
pA=pt(-2,2,'A');
pB=pt(2,2,'B');
pD=normal(pA,pB,function(){return 1;},'D');
pC=par(pA,pB,pD,'C');
quad(pA,pB,pC,pD);
mark(pA,pB,pC,'');
check = function(){return near(len(pA,pB),len(pB,pC)) && near(len(pA,pB),len(pC,pD)) && near(len(pA,pB),len(pD,pA)) && near(ang(pA,pB,pC),PI/2);};

text(-8,8,'I.46') <<display:'internal',fontSize:20>>;
text(-8,-8,function(){return check() ? '✓' : 'Degenerate or invalid inputs';}) <<display:'internal',fontSize:14>>;

// I.30: Lines parallel to the same line
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-4, 0);
B = point(4, 0);
C = point(-3, 3);
D = point(-2, -3);
l=line(A,B) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
m=parallel(l,C) <<dash:2>>;
k=parallel(l,D) <<dash:2>>;
E=point(map () -> X(B)+X(C)-X(A),map () -> Y(B)+Y(C)-Y(A)) <<name:'E', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
F=point(map () -> X(B)+X(D)-X(A),map () -> Y(B)+Y(D)-Y(A)) <<name:'F', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
text(-8,8,'I.30') <<display:'internal',fontSize:20>>;

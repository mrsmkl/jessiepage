// I.15: Vertical angles
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

O = point(0, 0);
A = point(4, 0);
B = point(1, 3);
C=point(map () -> X(O)+(-1)*(X(A)-X(O)),map () -> Y(O)+(-1)*(Y(A)-Y(O))) <<name:'C', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
D=point(map () -> X(O)+(-1)*(X(B)-X(O)),map () -> Y(O)+(-1)*(Y(B)-Y(O))) <<name:'D', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
line(A,C) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
line(B,D) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
angle(A,O,B) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
angle(C,O,D) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
angle(B,O,C) <<name:'β', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
angle(D,O,A) <<name:'β', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.15') <<display:'internal',fontSize:20>>;

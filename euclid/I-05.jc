// I.5: Base angles of an isosceles triangle
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

B = point(-3, 0);
C = point(3, 0);
M=midpoint(B,C) <<name:'M'>>;
l=perpendicular(line(B,C),M) <<dash:2>>;
A = point(0, 4);
A.glide(l);
polygon(A,B,C) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
D=point(map () -> X(A)+(1.4)*(X(B)-X(A)),map () -> Y(A)+(1.4)*(Y(B)-Y(A))) <<name:'D', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
E=point(map () -> X(A)+(1.4)*(X(C)-X(A)),map () -> Y(A)+(1.4)*(Y(C)-Y(A))) <<name:'E', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
segment(B,D) <<strokeWidth:2, strokeColor:'#34465d'>>;
segment(C,E) <<strokeWidth:2, strokeColor:'#34465d'>>;
angle(A,B,C) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
angle(B,C,A) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.5') <<display:'internal',fontSize:20>>;

// I.23: Copy an angle
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-6, 0);
B = point(-3, 0);
C = point(-5, 3);
polygon(A,B,C) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
D = point(1, 0);
E = point(5, 0);
F=point(map () -> X(D)+(dist(A,B)/dist(D,E))*(X(E)-X(D)),map () -> Y(D)+(dist(A,B)/dist(D,E))*(Y(E)-Y(D))) <<name:'F', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
c1=circle(D,map () -> dist(A,C)) <<dash:2>>;
c2=circle(F,map () -> dist(B,C)) <<dash:2>>;
G=intersection(c1,c2,0) <<name:'G'>>;
segment(D,E) <<strokeWidth:2, strokeColor:'#34465d'>>;
polygon(D,F,G) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
angle(B,A,C) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
angle(F,D,G) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.23') <<display:'internal',fontSize:20>>;

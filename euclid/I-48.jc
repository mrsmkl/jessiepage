// I.48: Converse of the Pythagorean theorem
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-2, 0);
B = point(2, 0);
H = point(-6, -4);
K = point(-3, -4);
segment(H,K) <<strokeWidth:2, strokeColor:'#34465d'>>;
c1=circle(A,map () -> dist(H,K)) <<dash:2>>;
c2=circle(B,map () -> sqrt(dist(A,B)^2+dist(H,K)^2)) <<dash:2>>;
C=intersection(c1,c2,0) <<name:'C'>>;
polygon(A,B,C) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
D=point(map () -> X(A)-(-dist(H,K)/dist(A,B))*(Y(B)-Y(A)),map () -> Y(A)+(-dist(H,K)/dist(A,B))*(X(B)-X(A))) <<name:'D', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
polygon(A,B,D) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
angle(B,A,C) <<name:'', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.48') <<display:'internal',fontSize:20>>;

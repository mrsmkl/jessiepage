// I.47: Pythagorean theorem
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-2, 1);
B = point(2, 1);
l=perpendicular(line(A,B),A) <<visible:false>>;
C = point(-2, 4);
C.glide(l);
polygon(A,B,C) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
s1D=point(map () -> X(A)-(-1)*(Y(B)-Y(A)),map () -> Y(A)+(-1)*(X(B)-X(A))) <<name:'', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
s1C=point(map () -> X(B)+X(s1D)-X(A),map () -> Y(B)+Y(s1D)-Y(A)) <<name:'', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
polygon(A,B,s1C,s1D) <<fillColor:'#cf9945', fillOpacity:0.15, borders:<<strokeColor:'#846632',strokeWidth:2>>>>;
s1=[s1C,s1D];
s2D=point(map () -> X(B)-(-1)*(Y(C)-Y(B)),map () -> Y(B)+(-1)*(X(C)-X(B))) <<name:'', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
s2C=point(map () -> X(C)+X(s2D)-X(B),map () -> Y(C)+Y(s2D)-Y(B)) <<name:'', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
polygon(B,C,s2C,s2D) <<fillColor:'#cf9945', fillOpacity:0.15, borders:<<strokeColor:'#846632',strokeWidth:2>>>>;
s2=[s2C,s2D];
s3D=point(map () -> X(C)-(-1)*(Y(A)-Y(C)),map () -> Y(C)+(-1)*(X(A)-X(C))) <<name:'', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
s3C=point(map () -> X(A)+X(s3D)-X(C),map () -> Y(A)+Y(s3D)-Y(C)) <<name:'', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
polygon(C,A,s3C,s3D) <<fillColor:'#cf9945', fillOpacity:0.15, borders:<<strokeColor:'#846632',strokeWidth:2>>>>;
s3=[s3C,s3D];
q=perpendicular(line(B,C),A) <<dash:2>>;
edge=line(s2[0],s2[1]) <<visible:false>>;
R=intersection(q,edge,0) <<name:'L'>>;
segment(A,R) <<strokeWidth:2, strokeColor:'#34465d'>>;
segment(A,s2[1]) <<strokeColor:'#b45b27',dash:2>>;
segment(C,s1[0]) <<strokeColor:'#b45b27',dash:2>>;
segment(A,s2[0]) <<strokeColor:'#245ea6',dash:2>>;
segment(B,s3[0]) <<strokeColor:'#245ea6',dash:2>>;
angle(B,A,C) <<name:'', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.47') <<display:'internal',fontSize:20>>;

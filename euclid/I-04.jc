// I.4: Side-angle-side congruence
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-6, 0);
B = point(-3, 0);
C = point(-5, 3);
D=point(map () -> X(A)+7,map () -> Y(A)+0) <<name:'D', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
E=point(map () -> X(B)+7,map () -> Y(B)+0) <<name:'E', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
F=point(map () -> X(C)+7,map () -> Y(C)+0) <<name:'F', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
polygon(A,B,C) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
polygon(D,E,F) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
angle(B,A,C) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
angle(E,D,F) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.4') <<display:'internal',fontSize:20>>;

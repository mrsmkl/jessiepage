// I.9: Bisect an angle
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-3, 0);
B = point(3, 0);
C = point(-1, 4);
polygon(A,B,C) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
D=point(map () -> X(A)+(dist(A,B)/dist(A,C))*(X(C)-X(A)),map () -> Y(A)+(dist(A,B)/dist(A,C))*(Y(C)-Y(A))) <<name:'D', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
circle(A,B) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
c1=circle(B,D) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
c2=circle(D,B) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
E=intersection(c1,c2,0) <<name:'E'>>;
F=intersection(c1,c2,1) <<name:'F'>>;
bd=line(B,D) <<visible:false>>;
ef=line(E,F) <<visible:false>>;
M=intersection(bd,ef,0) <<name:'M'>>;
segment(B,D) <<strokeWidth:2, strokeColor:'#34465d'>>;
segment(A,M) <<strokeWidth:2, strokeColor:'#34465d'>>;
angle(B,A,M) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
angle(M,A,D) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.9') <<display:'internal',fontSize:20>>;

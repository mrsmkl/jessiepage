// I.12: Drop a perpendicular to a line
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-3, 0);
B = point(3, 0);
C = point(0, 3);
l=line(A,B) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
c=circle(C,map () -> sqrt(((X(B)-X(A))*(Y(C)-Y(A))-(Y(B)-Y(A))*(X(C)-X(A)))^2/dist(A,B)^2+dist(A,B)^2/4)) <<dash:2>>;
D=intersection(l,c,0) <<name:'D'>>;
E=intersection(l,c,1) <<name:'E'>>;
M=midpoint(D,E) <<name:'M'>>;
segment(C,M) <<strokeWidth:2, strokeColor:'#34465d'>>;
angle(A,M,C) <<name:'', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.12') <<display:'internal',fontSize:20>>;

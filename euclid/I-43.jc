// I.43: Equal complements about a diagonal
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-4, 0);
B = point(4, 0);
D = point(-2, 5);
C=point(map () -> X(B)+X(D)-X(A),map () -> Y(B)+Y(D)-Y(A)) <<name:'C', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
polygon(A,B,C,D) <<fillColor:'#cf9945', fillOpacity:0.15, borders:<<strokeColor:'#846632',strokeWidth:2>>>>;
diag=segment(A,C) <<strokeWidth:2, strokeColor:'#34465d'>>;
slide=slider([-6,-3],[-2,-3],[0.05,0.5,0.95]) <<name:'Division',snapWidth:0.01>>;
P=point(map () -> X(A)+(slide.Value())*(X(C)-X(A)),map () -> Y(A)+(slide.Value())*(Y(C)-Y(A))) <<name:'P', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
t=map () -> dist(A,P)/dist(A,C);
E=point(map () -> X(A)+t()*(X(B)-X(A)),map () -> Y(A)+t()*(Y(B)-Y(A))) <<name:'E', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
F=point(map () -> X(A)+t()*(X(D)-X(A)),map () -> Y(A)+t()*(Y(D)-Y(A))) <<name:'F', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
G=point(map () -> X(B)+X(F)-X(A),map () -> Y(B)+Y(F)-Y(A)) <<name:'G', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
H=point(map () -> X(D)+X(E)-X(A),map () -> Y(D)+Y(E)-Y(A)) <<name:'H', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
segment(E,H) <<strokeWidth:2, strokeColor:'#34465d'>>;
segment(F,G) <<strokeWidth:2, strokeColor:'#34465d'>>;
polygon(E,B,G,P) <<fillColor:'#cf9945', fillOpacity:0.15, borders:<<strokeColor:'#846632',strokeWidth:2>>>>;
polygon(F,P,H,D) <<fillColor:'#cf9945', fillOpacity:0.15, borders:<<strokeColor:'#846632',strokeWidth:2>>>>;
text(-8,8,'I.43') <<display:'internal',fontSize:20>>;

// Euclid Book I — Postulate 5: The parallel postulate
// If a transversal makes same-side interior angles sum to less than two right angles, the two lines meet on that side.
// Illustrative model of an assumption, not a proof.
// Used in: I.29; then I.30–48 through parallel-line results.
$board.setBoundingBox([-10, 7, 10, -7], true);

A = point(-4, 3);
B = point(0, 2);
C = point(-4, -3);
D = point(0, -2);
a=line(A,B); b=line(C,D);
segment(B,D) <<strokeColor:'#b45b27',strokeWidth:3>>;
R=point(map () -> 2*X(B)-X(A),map () -> 2*Y(B)-Y(A)) <<visible:false>>;
S=point(map () -> 2*X(D)-X(C),map () -> 2*Y(D)-Y(C)) <<visible:false>>;
E=intersection(a,b,0) <<name:'E'>>;
angle(R,B,D) <<name:'α',selection:'minor'>>;
angle(B,D,S) <<name:'β',selection:'minor'>>;
text(-9,-4.5,map () -> 'α + β = '+round(10*(min(deg(R,B,D),360-deg(R,B,D))+min(deg(B,D,S),360-deg(B,D,S))))/10+'°') <<display:'internal',fontSize:16>>;
text(-9,-5.5,'Here α + β < 180°: the lines meet on the right.') <<display:'internal',fontSize:16>>;
// Keep the marked rays on the right of transversal BD when exploring this case.
// At a 180-degree sum the lines are parallel and E has no finite position.
text(-9,6,'Postulate 5: The parallel postulate') <<display:'internal',fontSize:18>>;

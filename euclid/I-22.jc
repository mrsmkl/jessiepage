// I.22: Construct a triangle from three lengths
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

U = point(-6, -4);
V = point(-2, -4);
W = point(0, -4);
Z = point(3, -4);
H = point(5, -4);
K = point(10, -4);
segment(U,V) <<strokeWidth:2, strokeColor:'#34465d'>>;
segment(W,Z) <<strokeWidth:2, strokeColor:'#34465d'>>;
segment(H,K) <<strokeWidth:2, strokeColor:'#34465d'>>;
A = point(-2, 0);
B=point(map () -> X(A)+dist(U,V),map () -> Y(A)) <<name:'B', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
c1=circle(A,map () -> dist(H,K)) <<dash:2>>;
c2=circle(B,map () -> dist(W,Z)) <<dash:2>>;
C=intersection(c1,c2,0) <<name:'C'>>;
polygon(A,B,C) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
text(-8,8,'I.22') <<display:'internal',fontSize:20>>;

// I.10: Bisect a segment
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-3, 0);
B = point(3, 0);
c1=circle(A,B) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
c2=circle(B,A) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
C=intersection(c1,c2,0) <<name:'C'>>;
D=intersection(c1,c2,1) <<name:'D'>>;
l=line(C,D) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
M=intersection(line(A,B),l,0) <<name:'M'>>;
segment(A,B) <<strokeWidth:2, strokeColor:'#34465d'>>;
text(-8,8,'I.10') <<display:'internal',fontSize:20>>;

// I.1: Construct an equilateral triangle
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-2, 0);
B = point(2, 0);
c1=circle(A,B) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
c2=circle(B,A) <<strokeColor:'#9ba9b9',strokeWidth:1,dash:2>>;
C=intersection(c1,c2,0) <<name:'C'>>;
polygon(A,B,C) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
angle(B,A,C) <<name:'60°', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
angle(A,B,C) <<name:'60°', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.1') <<display:'internal',fontSize:20>>;

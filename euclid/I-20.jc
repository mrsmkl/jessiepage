// I.20: Triangle inequality
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-3, 0);
B = point(3, 0);
C = point(-1, 4);
polygon(A,B,C) <<fillColor:'#548abd', fillOpacity:0.12, borders:<<strokeColor:'#34465d',strokeWidth:2>>>>;
D=point(map () -> X(B)+(1+dist(A,C)/dist(A,B))*(X(A)-X(B)),map () -> Y(B)+(1+dist(A,C)/dist(A,B))*(Y(A)-Y(B))) <<name:'D', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
segment(A,D) <<strokeWidth:2, strokeColor:'#34465d'>>;
segment(C,D) <<strokeWidth:2, strokeColor:'#34465d'>>;
text(-8,8,'I.20') <<display:'internal',fontSize:20>>;

// I.31: Draw a parallel through a point
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-4, 0);
B = point(4, 0);
C = point(-1, 3);
l=line(A,B) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
D=point(map () -> X(B)+X(C)-X(A),map () -> Y(B)+Y(C)-Y(A)) <<name:'D', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
m=line(C,D) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
segment(A,C) <<strokeWidth:2, strokeColor:'#34465d'>>;
text(-8,8,'I.31') <<display:'internal',fontSize:20>>;

// I.29: Angles made by a transversal of parallel lines
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-4, 0);
B = point(4, 0);
C = point(-3, 3);
D=point(map () -> X(B)+X(C)-X(A),map () -> Y(B)+Y(C)-Y(A)) <<name:'D', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
l=line(A,B) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
m=line(C,D) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
E=point(map () -> X(A)+(0.5)*(X(B)-X(A)),map () -> Y(A)+(0.5)*(Y(B)-Y(A))) <<name:'E', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
F=point(map () -> X(C)+(0.65)*(X(D)-X(C)),map () -> Y(C)+(0.65)*(Y(D)-Y(C))) <<name:'F', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
line(E,F) <<strokeColor:'#99a4af',strokeWidth:1,dash:2>>;
angle(A,E,F) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
angle(E,F,D) <<name:'α', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
angle(B,E,F) <<name:'β', radius:0.55, selection:'minor', fillColor:'#d99c46', fillOpacity:0.24, strokeColor:'#b47a2e', withLabel:true, label:<<display:'internal'>>>>;
text(-8,8,'I.29') <<display:'internal',fontSize:20>>;

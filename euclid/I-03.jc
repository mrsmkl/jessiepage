// I.3: Cut the shorter length from the longer
// Drag plain point assignments to update their coordinates in the editor.
$board.setBoundingBox([-9, 9, 13, -9], true);

A = point(-3, 1);
B = point(3, 1);
C = point(-3, -2);
D = point(-1, -1);
segment(A,B) <<strokeWidth:2, strokeColor:'#34465d'>>;
segment(C,D) <<strokeWidth:2, strokeColor:'#34465d'>>;
E=point(map () -> X(A)+(dist(C,D)/dist(A,B))*(X(B)-X(A)),map () -> Y(A)+(dist(C,D)/dist(A,B))*(Y(B)-Y(A))) <<name:'E', size:2, strokeColor:'#b45b27', fillColor:'#b45b27'>>;
circle(A,map () -> dist(C,D)) <<dash:2>>;
segment(A,E) <<strokeWidth:2, strokeColor:'#34465d'>>;
text(-8,8,'I.3') <<display:'internal',fontSize:20>>;
